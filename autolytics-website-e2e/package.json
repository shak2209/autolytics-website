{
  "name": "autolytics-website-e2e",
  "version": "1.0.0",
  "description": "Playwright + TypeScript BDD test framework for the Autolytics IT Consultancy website, generated from a CSV of Gherkin scenarios",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "generate": "tsx scripts/generate-features.ts && bddgen",
    "test": "npm run generate && playwright test",
    "test:chrome": "npm run generate && playwright test --project=chrome",
    "test:firefox": "npm run generate && playwright test --project=firefox",
    "test:edge": "npm run generate && playwright test --project=edge",
    "test:smoke": "npm run generate && playwright test --grep @smoke",
    "test:headed": "npm run generate && playwright test --headed --workers=1",
    "report": "playwright show-report reports/playwright-html",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install firefox"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "csv-parse": "^7.0.3",
    "playwright-bdd": "^9.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
